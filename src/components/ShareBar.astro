---
const { text, url, id, hidden } = Astro.props as { text: string; url: string; id?: string; hidden?: boolean };
const e = encodeURIComponent;
const items = [
  ["X", `https://x.com/intent/post?text=${e(text)}&url=${e(url)}`],
  ["WhatsApp", `https://wa.me/?text=${e(text + " " + url)}`],
  ["Facebook", `https://www.facebook.com/sharer/sharer.php?u=${e(url)}`],
  ["Telegram", `https://t.me/share/url?url=${e(url)}&text=${e(text)}`],
  ["Reddit", `https://www.reddit.com/submit?url=${e(url)}&title=${e(text)}`],
  ["LinkedIn", `https://www.linkedin.com/sharing/share-offsite/?url=${e(url)}`],
];
---
<div class="sharebar" id={id} hidden={hidden}>
  {items.map(([n, h]) => <a href={h} target="_blank" rel="noopener">{n}</a>)}
  <button type="button" data-copy={url}>Copy link</button>
</div>
