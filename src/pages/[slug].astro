---
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import Signup from "../components/Signup.astro";
import ShareBar from "../components/ShareBar.astro";
import Cover from "../components/Cover.astro";
import { getPosts, fmtDate, postPath, postUrl, ogImage, type Post } from "../lib";
import { SITE, SITE_NAME } from "../config";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({ params: { slug: post.id }, props: { post, next: posts[(i + 1) % posts.length] } }));
}
const { post, next } = Astro.props as { post: Post; next: Post };
const { Content } = await render(post);
const d = post.data;
const url = postUrl(post);
const image = ogImage(post);
const jsonLd = {
  "@context": "https://schema.org", "@type": "BlogPosting",
  headline: d.title, description: d.description || d.dek, image, url, mainEntityOfPage: url,
  datePublished: d.date.toISOString(), articleSection: d.front,
  author: { "@type": "Organization", name: SITE_NAME, url: SITE + "/" },
  publisher: { "@type": "Organization", name: SITE_NAME, url: SITE + "/" },
};
---
<Base title={`${d.title} | ${SITE_NAME}`} description={d.description || d.dek} image={image} imageAlt={`Cover art for ${d.title}`}
  type="article" nav="home" reading published={d.date} section={d.front} jsonLd={jsonLd}>
  <div class="page-narrow">
    <article class="article" data-slug={post.id} data-url={url}>
      <a class="back" href="/">&larr; All posts</a>
      <div class="meta" style="margin-top:1.4rem"><span class="front">{d.front}</span><span>{fmtDate(d.date)}</span><span>{d.read} read</span></div>
      <h1>{d.title}</h1>
      <p class="dek">{d.dek}</p>
      <div class="tools">
        <button type="button" class="tbtn" id="shareTop" aria-expanded="false" aria-controls="topshare">Share</button>
      </div>
      <ShareBar text={d.title} url={url} id="topshare" hidden />
      <div class="listen" id="listen">
        <span class="ll">Listen to this article</span>
        <button type="button" class="tbtn" id="lplay">&#9654; Listen</button>
        <button type="button" class="tbtn" id="lstop" hidden>&#9632; Stop</button>
        <label for="voice" class="sr">Voice</label>
        <select id="voice"><option value="">Default voice</option></select>
        <label for="rate" class="sr">Speed</label>
        <select id="rate"><option value="0.85">0.85&times;</option><option value="1" selected>1&times;</option><option value="1.2">1.2&times;</option><option value="1.5">1.5&times;</option></select>
      </div>
      <Cover post={post} kind="cover" />
      <div class="body"><Content /></div>
      <div class="share-wrap">
        <div class="dateline">Share this article</div>
        <ShareBar text={d.title} url={url} />
      </div>
      <section class="engage" aria-label="Reactions and comments">
        <h2>How did this hit you?</h2>
        <div class="reacts" id="reacts"></div>
        <h2 id="ctitle">Comments</h2>
        <form class="cform" id="cform" novalidate>
          <label for="cname" class="sr">Your name</label>
          <input id="cname" maxlength="40" placeholder="Your name (optional)" autocomplete="nickname">
          <div class="hp" aria-hidden="true">
            <label for="cweb">Website (leave this empty)</label>
            <input id="cweb" name="website" tabindex="-1" autocomplete="off">
          </div>
          <label for="ctext" class="sr">Your comment</label>
          <textarea id="ctext" maxlength="1000" placeholder="Say it. Links welcome."></textarea>
          <button class="btn" type="submit">Post comment</button>
          <div class="note" id="cnote" role="status"></div>
        </form>
        <ol class="clist" id="clist"></ol>
      </section>
      <div class="next">
        <div class="dateline">Read next</div>
        <div class="next-card"><h3><a href={postPath(next)}>{next.data.title}</a></h3><p>{next.data.dek}</p>
        <a class="more" href={postPath(next)}>Read more &rarr;</a></div>
      </div>
    </article>
    <Signup />
  </div>
</Base>
<script>import "../scripts/article";</script>
